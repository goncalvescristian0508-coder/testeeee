# mock (padrão) usa src/data/mock.ts; http usa createHttpApi em src/services/api.ts
VITE_API_MODE=mock
VITE_API_URL=http://localhost:3000/api
# mock (padrão) simula a verificação; http envia as imagens para VITE_API_URL/identity (ver docs/API-IDENTIDADE.md)
VITE_IDENTITY_MODE=mock
# Minutos da análise simulada da conta (padrão 5)
VITE_ANALISE_MINUTOS=5
