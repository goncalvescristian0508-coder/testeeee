# ---- Supabase (obrigatório) ----
# Painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
# Usada SOMENTE no servidor (envio de push agendado). Nunca exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# ---- Web Push (opcional, mas necessário para notificações) ----
# Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# Segredo para proteger o endpoint de agendamento (/api/cron/reminders).
# Na Vercel, o Cron envia automaticamente "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# URL pública do app (usada em e-mails de confirmação e links de notificação)
NEXT_PUBLIC_APP_URL=http://localhost:3000
